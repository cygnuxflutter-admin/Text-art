<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/brand_orange_light" />
            <stroke android:width="1.5dp" android:color="@color/brand_orange" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/pill_bg_unselected" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/pill_bg_unselected" />
        </shape>
    </item>
</selector>
