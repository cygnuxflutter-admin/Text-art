<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- Top Header -->
    <RelativeLayout
        android:id="@+id/cropHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/knack_ic_close"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Crop Photo"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/knack_ic_done_24dp"
            app:tint="@color/brand_orange" />
    </RelativeLayout>

    <!-- Crop Image View -->
    <com.isseiaoki.simplecropview.CropImageView
        android:id="@+id/crop_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/cropHeader"
        app:layout_constraintBottom_toTopOf="@id/fixed_ratio_list"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        custom:scv_background_color="@color/bg_cream"
        custom:scv_crop_mode="fit_image"
        custom:scv_frame_color="@color/brand_orange"
        custom:scv_frame_stroke_weight="1.5dp"
        custom:scv_guide_color="@color/brand_orange"
        custom:scv_guide_show_mode="show_always"
        custom:scv_guide_stroke_weight="1.0dp"
        custom:scv_handle_color="@color/brand_orange"
        custom:scv_handle_show_mode="show_always"
        custom:scv_handle_size="12dp"
        custom:scv_min_frame_size="60dp"
        custom:scv_overlay_color="#99000000"
        custom:scv_touch_padding="12dp" />

    <RelativeLayout
        android:id="@+id/loadingView"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@android:color/transparent"
        android:elevation="200dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/crop_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/crop_view">

        <ProgressBar
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/brand_orange" />
    </RelativeLayout>

    <!-- Aspect Ratio List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fixed_ratio_list"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/confirmToolbar" />

    <!-- Bottom Controls (Rotate) -->
    <LinearLayout
        android:id="@+id/confirmToolbar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/rotate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/knack_rotate"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Rotate 90°"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>