<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/knack_rounded_border_dialog"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_marginTop="@dimen/_6sdp"
        android:id="@+id/native_banner_ad_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_200sdp"
        android:layout_alignParentBottom="true"
        android:layout_centerVertical="true"
        android:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/knack_rounded_border_dialog"
        android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="87"
        android:fontFamily="@font/futural_hv_bt"
        android:lineSpacingExtra="20dp"
        android:text="Text Art"
        android:textAlignment="center"
        android:textColor="@color/colorBlack"
        android:textSize="17dp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="60"
        android:fontFamily="@font/futura_bk_bt"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:text="@string/if_you_exit"
        android:textColor="@color/colorBlack"
        android:textSize="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:id="@+id/card"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            app:cardCornerRadius="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_10sdp">

            <TextView
                android:id="@+id/cancel"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@color/selected"
                android:clickable="true"
                android:fontFamily="@font/aler"
                android:gravity="center"
                android:text="Cancel"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="14dp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_80sdp"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/card"
            app:cardCornerRadius="@dimen/_5sdp">

            <TextView
                android:id="@+id/exit"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="36dp"
                android:background="@color/selected"
                android:clickable="true"
                android:fontFamily="@font/aler"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Exit"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="14dp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
