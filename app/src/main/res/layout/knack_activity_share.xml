<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeShare"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/toolBarShare"
        android:layout_width="match_parent"
        android:layout_height="70dp">

        <ImageView
            android:id="@+id/btnBackShare"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:padding="16dp"
            android:src="@drawable/ic_back_selected" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/futura_bk_bt"
            android:text="@string/preview"
            android:textColor="@color/selected"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/btn_new"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:fontFamily="@font/san_bold"
            android:gravity="center"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:src="@drawable/knack_ic_home"
            android:text="New"
            android:textAllCaps="true"
            android:textColor="@color/selected"
            android:textSize="14dp"
            app:tint="@color/selected" />
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/img_final_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolBarShare"
        android:layout_centerHorizontal="true"
        android:background="@color/edit_bg"
        app:cardCornerRadius="4dp">

        <ImageView
            android:id="@+id/img_final"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/knack_main" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#33000000" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvSaved"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/rv_game"
        android:layout_centerInParent="true"
        android:fontFamily="@font/aler"
        android:padding="10dp"
        android:text="@string/saved"
        android:textColor="@color/selected"
        android:textSize="24sp"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/rv_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/img_final_card"
        android:layout_marginTop="10dp">

<!--
        <ImageView
            android:id="@+id/iv_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:adjustViewBounds="true"
            android:src="@drawable/game_shareactivity" />-->

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ltSaveShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btm"
        android:layout_below="@+id/rv_game"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:weightSum="2">


        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/knack_bg_rate"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:cardCornerRadius="@dimen/_5sdp">

            <LinearLayout
                android:id="@+id/ltShare"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/selected"
                android:gravity="center">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:srcCompat="@drawable/knack_ic_share" />

                <TextView
                    android:id="@+id/tvShare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:fontFamily="@font/aler"
                    android:text="@string/share"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/knack_bg_rate"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:cardCornerRadius="@dimen/_5sdp">

            <LinearLayout
                android:id="@+id/ltWall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/selected"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:srcCompat="@drawable/knack_ic_wall" />

                <TextView
                    android:id="@+id/tvWall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:fontFamily="@font/aler"
                    android:text="@string/wall"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>


    <!--    <RelativeLayout-->
    <!--        android:id="@+id/native_banner_ad_container"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="@dimen/_200sdp"-->
    <!--        android:layout_alignParentBottom="true"-->
    <!--        android:layout_centerVertical="true"-->
    <!--        android:visibility="visible" />-->

    <androidx.cardview.widget.CardView
        android:id="@+id/btm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginBottom="30dp"
        app:cardCornerRadius="@dimen/_8sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/knack_ad_bg">

            <RelativeLayout
                android:id="@+id/native_banner_ad_container"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_alignParentBottom="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:visibility="visible" />
        </RelativeLayout>

        <!--            <RelativeLayout-->
        <!--                android:id="@+id/native_banner_ad_container"-->
        <!--                android:layout_width="match_parent"-->
        <!--                android:layout_height="150dp"-->
        <!--                android:layout_alignParentBottom="true"-->
        <!--                android:layout_centerVertical="true"-->
        <!--                android:layout_margin="@dimen/_4sdp"-->
        <!--                android:visibility="visible" />-->

    </androidx.cardview.widget.CardView>

</RelativeLayout>
